<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".MainActivity"
        android:orientation="vertical"
        android:background="#ffff00">
        <TextView Phones>
            android:text="phones"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:autoSizeTextType="uniform" >
        </TextView>
    </LinearLayout>>

    <TableLayout>
        <TextView
            android:id="@+id/idPhoneCase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_margin="20dp"
            android:gravity="center"
            android:padding="10dp"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id= "@+id/CInputAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginLeft="80dp"
            android:text="Type the amount bought"
            android:textSize="20dp"
            android:textStyle="bold" />

        <ButtonADD
            android:id= "@+id/CAddAmount"
            android:layout_width="180dp"
            android:layout_height="60dp"
            android:layout_marginLeft="180dp"
            android:layout_marginTop="20dp"
            android:text="Add"
            android:textColor="#FFFF"/>

        <TextView2
            android:id="@+id/idPhoneCase2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_margin="20dp"
            android:gravity="center"
            android:padding="10dp"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText2
            android:id= "@+id/CInputAmount2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginLeft="80dp"
            android:text="Write the color name !"
            android:textSize="20dp"
            android:textStyle="bold" />

        <ButtonADD2
            android:id= "@+id/CAddAmount2"
            android:layout_width="180dp"
            android:layout_height="60dp"
            android:layout_marginLeft="180dp"
            android:layout_marginTop="20dp"
            android:text="Add"
            android:textColor="#FFFF"/>

        <TextView3
            android:id="@+id/idPhoneCase3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_margin="20dp"
            android:gravity="center"
            android:padding="10dp"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText3
            android:id= "@+id/CInputAmount3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginLeft="80dp"
            android:text="Write the color name !"
            android:textSize="20dp"
            android:textStyle="bold" />

        <ButtonADD3
            android:id= "@+id/CAddAmount3"
            android:layout_width="180dp"
            android:layout_height="60dp"
            android:layout_marginLeft="180dp"
            android:layout_marginTop="20dp"
            android:text="rectangle"
            android:textColor="#FFFF"/>

        <ButtonPhone
            android:id= "@+id/ToPhone"
            android:layout_width="180dp"
            android:layout_height="60dp"
            android:layout_marginLeft="180dp"
            android:layout_marginTop="20dp"
            android:text="Phones"
            android:textColor="#FFFF"/>

        <ButtonCart
            android:id= "@+id/ToCart"
            android:layout_width="180dp"
            android:layout_height="60dp"
            android:layout_marginLeft="180dp"
            android:layout_marginTop="20dp"
            android:text="Cart"
            android:textColor="#FFFF"/>
    </TableLayout>
</selector>